[Unit]
Description=p2pwiki config drift probe: loaded extensions + <ref> rendering (LocalSettings.php is NOT in the p2pfoundation-wiki repo)
After=docker.service
OnFailure=unit-failure-notify@%n.service

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/opt/scripts/p2pwiki-extension-drift-probe.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
