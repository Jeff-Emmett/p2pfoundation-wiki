# Copy to mail.env on GX10 and fill in. NOT committed (see .gitignore).
#
# PORT 465 vs 587 MATTERS, and this wiki has been bitten by it before: the
# production LocalSettings carried 587 and mail silently failed until it was
# changed to 465. PEAR Mail does not do STARTTLS negotiation the way you might
# expect — for implicit TLS on 465 the host needs the ssl:// prefix, and that
# prefix is part of the HOST value, not a separate setting.
#
#   implicit TLS  -> MW_SMTP_HOST=ssl://mail.example.net   MW_SMTP_PORT=465
#   STARTTLS      -> MW_SMTP_HOST=mail.example.net         MW_SMTP_PORT=587
#
# Use whichever the redeployed Mailcow actually offers; 465 is what worked here.
MW_SMTP_HOST=ssl://mail.rmail.online
MW_SMTP_PORT=465
MW_SMTP_USER=noreply@p2pfoundation.net
MW_SMTP_IDHOST=p2pfoundation.net

# The From: address on password-reset mail. Must be an address the Mailcow
# instance is willing to send AS, or it will be rejected as a spoof — this
# estate already has a finding about exactly that (SPOOFED_UNAUTH 5.7.1).
MW_PASSWORD_SENDER=noreply@p2pfoundation.net
